# Configuration for the email relay on the database host (charizard).
# Install to /etc/kiam-mail.env, owned root:kiammail, mode 0640.
#
# The relay runs on this host rather than on Render because Render blocks
# outbound SMTP entirely ([Errno 101] Network is unreachable) while this box can
# reach Gmail. It reads the queue straight out of the local database, so the
# URL points at localhost.

DATABASE_URL=postgresql://***REMOVED***

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=simon.havlik@klubinvestoru.com
# Gmail app password (not the account password). Same value as MAIL_PASSWORD in
# the GitHub Actions / Render environment.
MAIL_PASSWORD=***REMOVED***
MAIL_DEFAULT_SENDER=simon.havlik@klubinvestoru.com

# Abort a stuck connection quickly.
MAIL_TIMEOUT=15
